<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>GrapherProgram</StartupObject>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>PMGrapherUploader</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FTPPm1025-self-contained\Program.cs" Link="FtpUploader.cs" />
    <EmbeddedResource Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.2\runtimes\win-x64\native\libSkiaSharp.dll"
                      LogicalName="PMGrapherUploader.libSkiaSharp.dll" />
    <PackageReference Include="FluentFTP" Version="53.0.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>

</Project>
